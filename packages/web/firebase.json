{
  "apphosting": {
    "backendId": "akboys-web",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "hosting": [
    {
      "target": "velvet",
      "public": "firebase-hosting-public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "akboys-web",
            "region": "us-central1"
          }
        }
      ]
    }
  ]
}
