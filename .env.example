# --- OpenAI ---
# Required. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# --- Server ---
PORT=3001
NODE_ENV=development
# Comma-separated allowlist when serving multiple frontend origins in prod.
CORS_ORIGIN=http://localhost:3000
# `memory` (default) or `firestore`. Memory loses sessions on restart.
SESSION_STORE=memory
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# --- Firebase / GCP (optional) ---
# Setting FIREBASE_PROJECT_ID enables Firestore-backed session persistence and
# the live cost dashboard. Run `gcloud auth application-default login` first.
FIREBASE_PROJECT_ID=
# Set to `true` to require Google sign-in via Firebase Auth.
FIREBASE_AUTH_ENABLED=false
NEXT_PUBLIC_FIREBASE_AUTH_ENABLED=false

# --- Firebase client SDK (used by the web app when Auth is on) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
